-- FIND BALL
local function findBall()
    local possibleNames = {
        ball = 1,
        soccerball = 2,
        gameball = 3
    }

    local found = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local priority = possibleNames[obj.Name:lower()]
            if priority then
                table.insert(found, {
                    part = obj,
                    priority = priority
                })
            end
        end
    end

    table.sort(found, function(a, b)
        return a.priority < b.priority
    end)

    return found[1] and found[1].part or nil
end

